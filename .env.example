# Server
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=giftreward
DB_USER=root
DB_PASS=root
DB_LOGGING=false
# Set DB_SSL=true for any MySQL-compatible host requiring TLS
# (TiDB Cloud serverless, PlanetScale, managed RDS with enforced SSL, etc).
# DB_SSL_CA defaults to the bundled CA at src/config/certs/ca-certificates.crt
# (a public CA bundle, safe to commit). Leave DB_SSL_CA unset to use it;
# override it only if a future non-serverless/self-hosted MySQL needs a
# different CA file.
DB_SSL=false
DB_SSL_CA=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin bootstrap (used only by the seed script)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_now

# reCAPTCHA v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# NOTE: Google OAuth login (the legacy app's "Continue with Google") was
# explicitly descoped during the port — not implemented. See CUTOVER.md.

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mail (SMTP, replaces PHP mail())
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GiftReward <no-reply@example.com>"

# Geo / proxy lookup providers
IP_API_URL=http://ip-api.com/json
IPAPI_CO_URL=https://ipapi.co
IPINFO_URL=https://ipinfo.io

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
